PORT=5000

# Render PostgreSQL usually provides this as the Internal Database URL.
DATABASE_URL=

# Local development fallback if DATABASE_URL is not set.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_nest
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_FULL_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# In-app listing payments (mobile money).
#   lenco = real payments through Lenco Pay (needs LENCO_API_TOKEN)
#   mock  = simulated payments for demos; numbers ending 1111111 succeed
#   unset = in-app payments switched off (admins record payments manually)
PAYMENT_PROVIDER=
LENCO_API_TOKEN=
# Defaults to https://api.lenco.co/access/v2; use the sandbox host Lenco gives you for testing.
LENCO_API_BASE_URL=

# Automatic WhatsApp alerts to landlords about viewing requests.
#   meta = WhatsApp Business Cloud API (needs the values below and an approved template)
#   log  = demo mode: alerts are written to the server log only
#   unset = off (students still send requests themselves with tap-to-send)
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_VIEWING=viewing_request
WHATSAPP_TEMPLATE_LANGUAGE=en
# Link included in alerts
WEB_APP_URL=https://student-home-iota.vercel.app
